# Backend
SECRET_KEY=change-this-to-a-long-random-string

# Local development:
DATABASE_URL=sqlite:///./data/portfolio.db

# Docker production:
# DATABASE_URL=sqlite:////app/data/portfolio.db

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8083,http://localhost,https://fran-portfolio.duckdns.org:10049,http://fran-portfolio.duckdns.org:10045

# DuckDNS token from https://www.duckdns.org (needed for Let's Encrypt DNS-01)
DUCKDNS_TOKEN=

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Aviso de cauciones (9:00 hora Argentina). Si SMTP_HOST queda vacío, no se manda mail.
# En Gmail hace falta una contraseña de aplicación, no la contraseña de la cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Si queda vacío, el aviso sale a ADMIN_EMAIL.
CAUCION_ALERT_EMAIL=
